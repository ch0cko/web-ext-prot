{
  "manifest_version": 3,
  "version": "1.0",
  "name": "Test",
  "permissions": ["storage"],

  "action": {
    "default_popup": "popup-window.html",
    "default_icon": {
      "19": "placeholder-toolbar-icon.jpg",
      "38": "placeholder-toolbar-icon.jpg"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}